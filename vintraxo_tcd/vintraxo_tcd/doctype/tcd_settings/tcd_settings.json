   "default": "https://cdn.jsdelivr.net/pyodide/v0.26.4/full/",
   "fieldname": "pyodide_index_url",
   "fieldtype": "Data",
   "label": "Pyodide Base URL",
   "description": "Folder that contains pyodide.js (self-host for offline sites). Must end with /",
   "depends_on": "enable_playgrounds"
  },
  {
   "default": "https://cdnjs.cloudflare.com/ajax/libs/sql.js/1.10.3/",
   "fieldname": "sqljs_base_url",
   "fieldtype": "Data",
   "label": "SQL.js Base URL",
   "description": "Folder that contains sql-wasm.js and sql-wasm.wasm. Must end with /",
   "depends_on": "enable_playgrounds"
  },
  {
   "fieldname": "media_section",
   "fieldtype": "Section Break",
   "label": "Media and Uploads"
