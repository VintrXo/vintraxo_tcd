 "fields": [
  {
   "fieldname": "general_section",
   "fieldtype": "Section Break",
   "label": "General"
  },
  {
   "default": "ar",
   "fieldname": "default_language",
   "fieldtype": "Select",
   "label": "Default Content Language",
   "options": "ar\nen"
  },
  {
   "default": "1",
   "fieldname": "enable_portal",
   "fieldtype": "Check",
   "label": "Enable Learner Portal"
  },
  {
   "fieldname": "enable_guest_access",
   "fieldtype": "Check",
   "label": "Allow Visitors Without Login",
   "description": "Visitors can read published pages, courses and paths of Public spaces (read only, in the portal; never through the API). Everything else still needs a login."
  },
  {
   "fieldname": "column_break_1",
   "fieldtype": "Column Break"
  },
  {
   "default": "Internal",
   "fieldname": "default_visibility",
   "fieldtype": "Select",
   "label": "Default Visibility",
   "options": "Public\nInternal\nRestricted"
  },
  {
   "fieldname": "default_review_months",
   "fieldtype": "Int",
   "label": "Default Review Cycle (Months)",
   "default": "12",
   "non_negative": 1,
   "description": "How often published pages are checked for accuracy; 0 turns reviews off"
  },
  {
   "fieldname": "enable_discussions",
   "fieldtype": "Check",
   "label": "Enable Lesson Discussions",
   "default": "1",
   "description": "Learners can ask questions under lessons and articles; staff answer and moderate"
  },
  {
   "fieldname": "sync_training_to_hr",
   "fieldtype": "Check",
   "label": "Record Completed Courses in HRMS",
   "default": "1",
   "description": "Needs HRMS: a completed course becomes a Training Event and Training Result for the employee"
  },
  {
   "fieldname": "enable_change_requests",
   "fieldtype": "Check",
   "label": "Readers Can Suggest Edits",
   "default": "1",
   "description": "Readers propose text changes to published pages; a reviewer accepts or rejects them"
  },
  {
   "default": "1",
   "fieldname": "require_approval_before_publish",
   "fieldtype": "Check",
   "label": "Require Approval Before Publish"
  },
  {
   "fieldname": "playground_section",
   "fieldtype": "Section Break",
   "label": "Playgrounds"
  },
  {
   "default": "1",
   "fieldname": "enable_playgrounds",
   "fieldtype": "Check",
   "label": "Enable Playgrounds"
  },
  {
   "fieldname": "allow_scorm",
   "fieldtype": "Check",
   "label": "Allow SCORM Packages",
   "description": "SCORM packages are served from this site and their JavaScript runs with the learner's session. Only administrators can upload them; upload only packages you trust."
  },
  {
   "default": "5",
   "fieldname": "playground_timeout_seconds",
   "fieldtype": "Int",
   "label": "Playground Timeout (seconds)"
  },
