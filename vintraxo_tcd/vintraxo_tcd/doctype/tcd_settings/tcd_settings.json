   "fieldtype": "Password",
   "label": "Runner Token",
   "depends_on": "runner_enabled"
  },
  {
   "fieldname": "column_break_runner",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "runner_cpu_seconds",
   "fieldtype": "Float",
   "label": "CPU Time Limit (Seconds)",
   "default": "5",
   "depends_on": "runner_enabled"
  },
  {
   "fieldname": "runner_wall_seconds",
   "fieldtype": "Float",
   "label": "Wall Time Limit (Seconds)",
   "default": "10",
   "depends_on": "runner_enabled"
  },
  {
   "fieldname": "runner_memory_mb",
   "fieldtype": "Int",
   "label": "Memory Limit (MB)",
   "default": "256",
   "depends_on": "runner_enabled"
  },
  {
   "fieldname": "runner_runs_per_minute",
