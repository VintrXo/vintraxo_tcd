{
 "actions": [],
 "creation": "2026-11-19 17:00:00.000000",
 "doctype": "DocType",
 "engine": "InnoDB",
 "field_order": [
  "question",
  "question_type",
  "category",
  "ai_status",
  "ai_source",
  "column_break_1",
  "points",
  "manual_review",
  "scenario",
  "answers_section",
