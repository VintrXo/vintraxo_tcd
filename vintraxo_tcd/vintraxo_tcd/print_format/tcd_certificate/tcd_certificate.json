 "css": ".print-format { padding: 0 !important; orientation: Landscape; page-width: 297mm; page-height: 210mm; margin-top: 8mm; margin-bottom: 8mm; margin-left: 8mm; margin-right: 8mm; }\n.tcd-cert { font-family: \"Noto Naskh Arabic\", \"Noto Sans Arabic\", \"DejaVu Sans\", sans-serif; color: #1f2937; }\n.tcd-cert-frame { border: 6px double #1d4ed8; padding: 36px 48px; text-align: center; min-height: 165mm; position: relative; }\n.tcd-cert-logo { width: 72px; height: 72px; }\n.tcd-cert-kicker { font-size: 34px; font-weight: bold; color: #1d4ed8; margin-top: 8px; }\n.tcd-cert-sub { font-size: 14px; letter-spacing: 3px; color: #f59e0b; text-transform: uppercase; }\n.tcd-cert-line { font-size: 18px; margin: 18px 0 6px; }\n.tcd-cert-name { font-size: 32px; font-weight: bold; border-bottom: 2px solid #f59e0b; display: inline-block; padding: 0 24px 6px; }\n.tcd-cert-title { font-size: 24px; font-weight: bold; color: #1d4ed8; }\n.tcd-cert-meta { width: 100%; margin-top: 36px; border-collapse: collapse; }\n.tcd-cert-meta td { width: 33%; text-align: center; font-size: 13px; }\n.tcd-cert-meta span { display: block; color: #6b7280; }\n.tcd-cert-meta b { font-size: 15px; }\n.tcd-cert-verify { margin-top: 24px; font-size: 11px; color: #6b7280; }\n.tcd-cert-status { position: absolute; top: 24px; left: 24px; padding: 4px 12px; border: 2px solid #b91c1c; color: #b91c1c; font-weight: bold; transform: rotate(-8deg); }",
 "custom_format": 1,
 "default_print_language": "ar",
 "disabled": 0,
 "docstatus": 0,
 "doc_type": "TCD Certificate",
 "doctype": "Print Format",
 "font_size": 14,
 "html": "{% set lang_ar = True %}\n<div class=\"tcd-cert\" dir=\"rtl\" lang=\"ar\">\n\t<div class=\"tcd-cert-frame\">\n\t\t<img class=\"tcd-cert-logo\" src=\"data:image/png;base64,\" alt=\"VX\">\n\t\t<div class=\"tcd-cert-kicker\">شهادة إتمام</div>\n\t\t<div class=\"tcd-cert-sub\">Certificate of Completion</div>\n\t\t<p class=\"tcd-cert-line\">تشهد VintraXo بأن</p>\n\t\t<div class=\"tcd-cert-name\">{{ doc.full_name | e }}</div>\n\t\t<p class=\"tcd-cert-line\">أتمّ بنجاح {{ \"مسار التعلّم\" if doc.certificate_for == \"Learning Path\" else \"دورة\" }}</p>\n\t\t<div class=\"tcd-cert-title\">{{ doc.title | e }}</div>\n\t\t<table class=\"tcd-cert-meta\">\n\t\t\t<tr>\n\t\t\t\t<td><span>تاريخ الإصدار</span><b dir=\"ltr\">{{ frappe.utils.formatdate(doc.issued_on, \"dd-MM-yyyy\") }}</b></td>\n\t\t\t\t<td><span>صالحة حتى</span><b dir=\"ltr\">{{ frappe.utils.formatdate(doc.expires_on, \"dd-MM-yyyy\") if doc.expires_on else \"—\" }}</b></td>\n\t\t\t\t<td><span>رقم الشهادة</span><b dir=\"ltr\">{{ doc.name | e }}</b></td>\n\t\t\t</tr>\n\t\t</table>\n\t\t<div class=\"tcd-cert-verify\" dir=\"ltr\">\n\t\t\t{{ frappe.utils.get_url(\"/verify/\" ~ doc.verification_code) | e }}\n\t\t</div>\n\t\t{% if doc.status != \"Active\" %}<div class=\"tcd-cert-status\">{{ doc.status | e }}</div>{% endif %}\n\t</div>\n</div>",
 "idx": 0,
 "line_breaks": 0,
